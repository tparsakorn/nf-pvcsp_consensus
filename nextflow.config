manifest {
    name            = 'nf-pvcsp'
    author          = 'Parsakorn Tapaopong'
    description     = 'PvCSP consensus from Nanopore amplicons (NanoPlot > Porechop_ABI > Chopper > NGSpeciesID/Medaka > ORF check)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'   // developed and tested with 26.04.6
    version         = '0.1.0'
}

params {
    // ---- Input / output ------------------------------------------------------------
    samplesheet            = null      // REQUIRED: CSV with columns barcode_id,fastq (see assets/samplesheet_example.csv)
    outdir                 = 'results' // relative to the folder you launch from

    // ---- Chopper (read filtering) --------------------------------------------------
    min_quality            = 10
    min_length             = 600
    max_length             = 1300      // wide on purpose: keeps every repeat-length variant

    // ---- NGSpeciesID / Medaka ------------------------------------------------------
    abundance_ratio        = 0.02      // keep clusters with >= 2 % of the filtered reads
    max_seqs_for_consensus = 500
    mapped_threshold       = 0.80
    aligned_threshold      = 0.50
    medaka_model           = null      // null = read from the FASTQ RG tag (Dorado output)

    // ---- Software environments -----------------------------------------------------
    // Default: Nextflow builds them from envs/*.yml on first run.
    // To reuse environments you already have, pass their folder, e.g.
    //   --ngs_env ~/miniconda3/envs/ngs --ngsid_env ~/miniconda3/envs/ngsid
    ngs_env                = "${projectDir}/envs/ngs.yml"
    ngsid_env              = "${projectDir}/envs/ngsid.yml"

    // ---- Resources -----------------------------------------------------------------
    max_cpus               = Runtime.runtime.availableProcessors()   // lower with --max_cpus N
}

conda.enabled = true

process {
    errorStrategy = 'finish'

    withLabel: 'ngs_env'   { conda = params.ngs_env   }
    withLabel: 'ngsid_env' { conda = params.ngsid_env }

    withName: 'NANOPLOT'    { cpus = { Math.min(2, params.max_cpus) } }
    withName: 'PORECHOP'    { cpus = { Math.min(4, params.max_cpus) } }
    withName: 'CHOPPER'     { cpus = { Math.min(2, params.max_cpus) } }
    withName: 'CHECK_ORF'   { cpus = 1 }
    // Heaviest step (NGSpeciesID + Medaka): takes up to 8 CPUs, so on a small machine
    // barcodes run through it one at a time.
    withName: 'NGSPECIESID' { cpus = { Math.min(8, params.max_cpus) } }
}

executor {
    cpus = params.max_cpus
}

report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
